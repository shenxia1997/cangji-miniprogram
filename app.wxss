@import './styles/tokens.wxss';

page {
  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--fs-body);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.num {
  font-family: 'DIN Alternate', 'SF Mono', 'Menlo', monospace;
  font-variant-numeric: tabular-nums;
}

.page-pad { padding: 0 var(--space-page); }

.card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--space-card);
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted { color: var(--color-muted); }
.small { font-size: var(--fs-small); }
.mini { font-size: var(--fs-mini); }
.secondary { color: var(--color-text-2); }

.divider { height: 1rpx; background: var(--color-line); }

.btn-primary {
  height: 96rpx;
  border-radius: var(--radius-btn);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--fs-title);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary.disabled { background: #C8D2E4; }

.btn-ghost {
  height: 96rpx;
  border-radius: var(--radius-btn);
  background: #F1F4F9;
  color: #33415C;
  font-size: var(--fs-title);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: var(--fs-mini);
  background: var(--color-tag);
  color: var(--color-tag-text);
}

.tag-sell { background: #FDECEA; color: #C62828; }
.tag-buy { background: #E8F6EE; color: #0F7B43; }
