.empty {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.empty-icon { font-size: 72rpx; opacity: 0.5; }
.empty-title {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-2);
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  text-align: center;
  line-height: 1.6;
}
.empty-action {
  margin-top: 32rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
}
