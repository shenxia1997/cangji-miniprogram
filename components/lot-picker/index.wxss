.mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(16, 24, 40, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.panel {
  width: 100%;
  max-height: 78vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
}
.panel-head { padding: 32rpx 32rpx 16rpx; }
.panel-title { font-size: 34rpx; font-weight: 600; }
.panel-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}
.panel-body { flex: 1; max-height: 46vh; padding: 0 32rpx; }

.lot {
  border: 1rpx solid var(--color-line);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.lot.on { border-color: var(--color-primary); background: #F7F9FF; }
.lot-main { display: flex; align-items: center; }
.chk {
  width: 36rpx; height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #D3DAE4;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #fff;
  margin-right: 16rpx;
  flex: 0 0 36rpx;
}
.chk.on { background: var(--color-primary); border-color: var(--color-primary); }
.lot-info { flex: 1; min-width: 0; }
.lot-title { display: flex; align-items: center; font-size: 28rpx; font-weight: 600; }
.lot-title .tag { margin-left: 12rpx; }
.lot-sub { margin-top: 6rpx; font-size: 22rpx; color: var(--color-muted); }

.stepper {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  overflow: hidden;
  width: 280rpx;
}
.step-btn {
  width: 72rpx; height: 60rpx; line-height: 60rpx;
  text-align: center; font-size: 32rpx; color: var(--color-text-2);
}
.step-val {
  flex: 1; height: 60rpx; line-height: 60rpx;
  text-align: center; font-size: 26rpx;
  border-left: 1rpx solid var(--color-line);
  border-right: 1rpx solid var(--color-line);
}

.panel-foot { padding: 20rpx 32rpx 40rpx; border-top: 1rpx solid var(--color-line); }
.foot-row { display: flex; align-items: center; justify-content: space-between; }
.fill { font-size: 24rpx; color: var(--color-primary); }
.preview {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx;
}
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.actions .btn-ghost, .actions .btn-primary { flex: 1; height: 88rpx; }
