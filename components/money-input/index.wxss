.mi {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.mi-input {
  flex: 1;
  text-align: left;
  font-family: 'DIN Alternate', 'SF Mono', monospace;
  font-size: 32rpx;
  color: var(--color-text);
}
.mi-input.right { text-align: right; }
.mi-ph { color: #C4CBD8; }
.mi-suffix {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}
