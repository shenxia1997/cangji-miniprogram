.hero {
  margin: 24rpx 0 32rpx;
  padding: 40rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1B2A4A 0%, #24365C 100%);
  color: #fff;
}
.hero-label { font-size: 24rpx; opacity: 0.72; }
.hero-value {
  display: block;
  margin-top: 12rpx;
  font-size: 64rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}
.hero-row { display: flex; margin-top: 28rpx; }
.hero-item { flex: 1; }
.hero-k { font-size: 22rpx; opacity: 0.6; }
.hero-v { display: flex; align-items: baseline; margin-top: 8rpx; font-size: 28rpx; }
.hero-pct { margin-left: 12rpx; font-size: 22rpx; opacity: 0.75; }

.section-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; }

.pos-row {
  display: flex; align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.pos-left { flex: 1.2; min-width: 0; }
.pos-name { display: block; font-size: 30rpx; font-weight: 600; }
.pos-code { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--color-muted); }
.pos-mid { flex: 1; text-align: right; }
.pos-qty { display: block; font-size: 28rpx; }
.pos-cost { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--color-muted); }
.pos-right { flex: 0.8; text-align: right; }
.pos-pct { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--color-muted); }

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  padding: 22rpx 40rpx;
  border-radius: 48rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(47, 91, 234, 0.32);
}
