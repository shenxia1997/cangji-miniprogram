.acc-row {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin: 20rpx 0;
}
.acc-name { font-size: 30rpx; font-weight: 600; }
.acc-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--color-muted); }
.acc-del { font-size: 26rpx; color: var(--color-up); }

.add-box { margin-top: 24rpx; }
.add-input {
  height: 88rpx; background: #fff; border-radius: 16rpx;
  padding: 0 24rpx; font-size: 28rpx; margin-bottom: 20rpx;
}

.tip { margin-top: 40rpx; padding: 0 8rpx; }
.tip-title { font-size: 26rpx; font-weight: 600; color: var(--color-text-2); }
.tip-body { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--color-muted); line-height: 1.7; }
