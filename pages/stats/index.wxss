.pills { display: flex; gap: 12rpx; margin: 24rpx 0; }
.pill {
  padding: 12rpx 28rpx; border-radius: 32rpx;
  background: #fff; font-size: 24rpx; color: var(--color-text-2);
}
.pill.on { background: var(--color-primary); color: #fff; }

.summary {
  padding: 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1B2A4A 0%, #24365C 100%);
  color: #fff;
  margin-bottom: 24rpx;
}
.summary-label { font-size: 24rpx; opacity: 0.7; }
.summary-value { margin-top: 10rpx; font-size: 56rpx; font-weight: 600; }
.summary-grid { display: flex; flex-wrap: wrap; margin-top: 28rpx; }
.sg-item { width: 50%; margin-bottom: 20rpx; }
.sg-k { font-size: 22rpx; opacity: 0.6; }
.sg-v { display: block; margin-top: 6rpx; font-size: 28rpx; }

.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.rank-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.rank-name { width: 180rpx; font-size: 26rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.rank-bar { flex: 1; height: 12rpx; background: #F1F4F9; border-radius: 6rpx; margin: 0 16rpx; overflow: hidden; }
.rank-fill { height: 100%; border-radius: 6rpx; }
.rank-fill.up { background: #E4453A; }
.rank-fill.down { background: #12A45B; }
.rank-val { width: 160rpx; text-align: right; font-size: 24rpx; }
.rank-val.up { color: var(--color-up); }
.rank-val.down { color: var(--color-down); }
